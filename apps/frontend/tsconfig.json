{
  // ブラウザ専用の型環境。types: [] のため Buffer / process などの Node API を
  // うっかり使うとここで型エラーになる（ブラウザで動くコードを Node 依存から守るための番人）。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/testing/**"]
}
